# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/astro
JWT_SECRET=change-me-to-a-long-random-string

# --- CORS (production) ---
# Comma-separated list. In production these are the only browser origins
# allowed with credentials. CORS_ORIGINS is optional extra entries
# (e.g. the admin panel URL).
CLIENT_URL=http://localhost:5173
# CORS_ORIGINS=https://admin.example.com

# --- AI providers ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# gemini-2.5-flash was retired (404) — use a supported model.
GOOGLE_MODEL=gemini-3.5-flash
CLOUDFLARE_AI_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# --- File uploads ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Voice (LiveKit) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Push notifications (Firebase Admin) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CURRENCY=INR
ALLOW_MOCK_RECHARGE=true
